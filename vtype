#!/usr/bin/env python3
"""vtype - push-to-talk dictation for any terminal program (built for Claude Code).

    vtype [--lang sv-SE] [--key f9] [--submit] [-- ] claude [args...]
    vtype --configure

Runs the command in a pseudo-terminal. Press the hotkey (default F9) to start
recording from the microphone; press it again to stop. The audio goes to the
ASR backend and the text is typed into the program's input. F10 cycles the
language. Recording state is shown in the terminal tab title.

The backend is chosen in ~/.config/vtype/config.toml (see --configure):
  local   asr_server.py on this machine, over a Unix socket (started automatically)
  remote  an external URL serving an OpenAI-compatible /v1/audio/transcriptions

Stdlib only: audio is captured from WSLg's PulseAudio server via libpulse-simple.
"""
import argparse
import array
import ctypes
import fcntl
import getpass
import io
import json
import os
import pty
import select
import signal
import socket
import struct
import subprocess
import sys
import termios
import threading
import time
import tomllib
import tty
import urllib.error
import urllib.request
import uuid
import wave

HERE = os.path.dirname(os.path.realpath(__file__))
SOCKET = os.path.expanduser("~/.cache/vtype/asr.sock")
SERVER_LOG = os.path.expanduser("~/.cache/vtype/server.log")
CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "vtype", "config.toml")
RATE = 16000

KEYS = {
    "f5": b"\x1b[15~", "f6": b"\x1b[17~", "f7": b"\x1b[18~", "f8": b"\x1b[19~",
    "f9": b"\x1b[20~", "f10": b"\x1b[21~", "f11": b"\x1b[23~", "f12": b"\x1b[24~",
    "ctrl-space": b"\x00",
}
LANGS = ["en-US", "sv-SE", "auto"]


# ---------------------------------------------------------------- audio capture

class PaSampleSpec(ctypes.Structure):
    _fields_ = [("format", ctypes.c_int), ("rate", ctypes.c_uint32), ("channels", ctypes.c_uint8)]


class Recorder:
    PA_STREAM_RECORD = 2
    PA_SAMPLE_S16LE = 3

    def __init__(self):
        self.lib = ctypes.CDLL("libpulse-simple.so.0")
        self.lib.pa_simple_new.restype = ctypes.c_void_p
        self.lib.pa_simple_new.argtypes = [
            ctypes.c_char_p, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_char_p,
            ctypes.POINTER(PaSampleSpec), ctypes.c_void_p, ctypes.c_void_p, ctypes.POINTER(ctypes.c_int),
        ]
        self.lib.pa_simple_read.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t, ctypes.POINTER(ctypes.c_int)]
        self.lib.pa_simple_free.argtypes = [ctypes.c_void_p]
        self.recording = threading.Event()
        self.frames = []
        self.thread = None
        self.error = None

    def start(self):
        self.frames = []
        self.error = None
        self.recording.set()
        self.thread = threading.Thread(target=self._run, daemon=True)
        self.thread.start()

    def stop(self):
        self.recording.clear()
        if self.thread:
            self.thread.join()
        return b"".join(self.frames)

    def _run(self):
        spec = PaSampleSpec(self.PA_SAMPLE_S16LE, RATE, 1)
        err = ctypes.c_int(0)
        s = self.lib.pa_simple_new(None, b"vtype", self.PA_STREAM_RECORD, None, b"dictation",
                                   ctypes.byref(spec), None, None, ctypes.byref(err))
        if not s:
            self.error = f"pa_simple_new failed ({err.value})"
            return
        chunk = RATE // 20 * 2  # 50 ms of int16
        buf = ctypes.create_string_buffer(chunk)
        try:
            while self.recording.is_set():
                if self.lib.pa_simple_read(s, buf, chunk, ctypes.byref(err)) < 0:
                    self.error = f"pa_simple_read failed ({err.value})"
                    return
                self.frames.append(buf.raw)
        finally:
            self.lib.pa_simple_free(s)


# ---------------------------------------------------------------- ASR backends

class LocalBackend:
    """asr_server.py on this machine, over a Unix socket."""
    name = "local"

    def prepare(self):
        if os.path.exists(SOCKET):
            return
        os.makedirs(os.path.dirname(SOCKET), exist_ok=True)
        py = os.path.join(HERE, ".venv", "bin", "python")
        with open(SERVER_LOG, "ab") as logf:
            subprocess.Popen([py, os.path.join(HERE, "asr_server.py"), "--warmup"],
                             stdin=subprocess.DEVNULL, stdout=logf, stderr=logf, start_new_session=True)

    def transcribe(self, pcm, lang, timeout=180):
        deadline = time.time() + timeout
        while True:
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.connect(SOCKET)
                break
            except (FileNotFoundError, ConnectionRefusedError):
                s.close()
                if time.time() > deadline:
                    raise RuntimeError("ASR server not reachable, see " + SERVER_LOG)
                time.sleep(0.5)
        with s:
            s.sendall((json.dumps({"lang": lang, "rate": RATE, "nbytes": len(pcm)}) + "\n").encode() + pcm)
            resp = json.loads(s.makefile("rb").readline())
        if "error" in resp:
            raise RuntimeError(resp["error"])
        return resp["text"]


class RemoteBackend:
    """An external server with an OpenAI-compatible /v1/audio/transcriptions endpoint
    (asr_server.py --http, vLLM, speaches, whisper.cpp server, OpenAI, Groq, ...)."""
    name = "remote"

    def __init__(self, url, api_key=None, model=None):
        url = url.rstrip("/")
        if not url.endswith("/audio/transcriptions"):
            url += "/audio/transcriptions" if url.endswith("/v1") else "/v1/audio/transcriptions"
        self.url, self.api_key, self.model = url, api_key, model or "whisper-1"

    def prepare(self):
        pass

    def transcribe(self, pcm, lang, timeout=120):
        wav = io.BytesIO()
        with wave.open(wav, "wb") as w:
            w.setnchannels(1)
            w.setsampwidth(2)
            w.setframerate(RATE)
            w.writeframes(pcm)
        fields = {"model": self.model, "response_format": "json"}
        if lang and lang != "auto":
            fields["language"] = lang.split("-")[0].lower()  # the API takes ISO-639-1: sv-SE -> sv
        boundary = uuid.uuid4().hex
        body = b"".join(f'--{boundary}\r\nContent-Disposition: form-data; name="{k}"\r\n\r\n{v}\r\n'.encode()
                        for k, v in fields.items())
        body += (f'--{boundary}\r\nContent-Disposition: form-data; name="file"; filename="audio.wav"\r\n'
                 f"Content-Type: audio/wav\r\n\r\n").encode() + wav.getvalue() + f"\r\n--{boundary}--\r\n".encode()
        req = urllib.request.Request(self.url, data=body, method="POST",
                                     headers={"Content-Type": f"multipart/form-data; boundary={boundary}"})
        if self.api_key:
            req.add_header("Authorization", f"Bearer {self.api_key}")
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                resp = json.loads(r.read())
        except urllib.error.HTTPError as e:
            detail = e.read().decode(errors="replace").strip()
            raise RuntimeError(f"remote ASR: HTTP {e.code} {detail[:200]}") from None
        except (urllib.error.URLError, OSError) as e:
            raise RuntimeError(f"remote ASR not reachable ({self.url}): {getattr(e, 'reason', e)}") from None
        if "error" in resp:
            raise RuntimeError(f"remote ASR: {resp['error']}")
        return resp["text"].strip()


# ---------------------------------------------------------------- configuration

def load_config():
    try:
        with open(CONFIG, "rb") as f:
            return tomllib.load(f)
    except FileNotFoundError:
        return {}
    except tomllib.TOMLDecodeError as e:
        sys.exit(f"vtype: invalid config {CONFIG}: {e}")


def save_config(cfg):
    def fmt(v):
        return ("true" if v else "false") if isinstance(v, bool) else json.dumps(v, ensure_ascii=False)
    lines = [f"{k} = {fmt(v)}" for k, v in cfg.items() if not isinstance(v, dict)]
    for table, values in cfg.items():
        if isinstance(values, dict) and values:
            lines += ["", f"[{table}]"] + [f"{k} = {fmt(v)}" for k, v in values.items()]
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    fd = os.open(CONFIG, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)  # may hold an API key
    with os.fdopen(fd, "w") as f:
        f.write("# vtype configuration - edit by hand or run `vtype --configure`\n" + "\n".join(lines) + "\n")


def configure():
    cfg = load_config()
    remote = dict(cfg.get("remote", {}))

    def ask(prompt, default=""):
        answer = input(f"{prompt}{f' [{default}]' if default else ''}: ").strip()
        return answer or default

    print("Where is the speech recognition model served?")
    print("  1) local   on this machine (asr_server.py, started automatically)")
    print("  2) remote  an external URL with an OpenAI-compatible /v1/audio/transcriptions endpoint")
    choice = ask("Choice", "2" if cfg.get("backend") == "remote" else "1")
    if choice in ("2", "remote"):
        cfg["backend"] = "remote"
        while not (url := ask("URL, e.g. https://asr.example.com/v1", remote.get("url", ""))):
            pass
        remote["url"] = url
        key = getpass.getpass("API key (Enter to keep current, '-' for none): " if remote.get("api_key")
                              else "API key (Enter for none): ").strip()
        if key == "-":
            remote.pop("api_key", None)
        elif key:
            remote["api_key"] = key
        remote["model"] = ask("Model name", remote.get("model", "whisper-1"))
        cfg["remote"] = remote
    else:
        cfg["backend"] = "local"
    cfg["lang"] = ask("Default language (en-US, sv-SE, auto, ...)", cfg.get("lang", "en-US"))
    save_config(cfg)
    print(f"Wrote {CONFIG}. Try it with: vtype --test-mic")


def make_backend(args, cfg):
    remote = cfg.get("remote", {})
    name = (args.backend or os.environ.get("VTYPE_BACKEND")
            or ("remote" if args.url else None) or cfg.get("backend") or "local")
    if name == "local":
        return LocalBackend()
    if name != "remote":
        sys.exit(f"vtype: unknown backend {name!r} (use local or remote)")
    url = args.url or os.environ.get("VTYPE_URL") or remote.get("url")
    if not url:
        sys.exit("vtype: remote backend needs a URL: run `vtype --configure`, set VTYPE_URL, or pass --url")
    return RemoteBackend(url, os.environ.get("VTYPE_API_KEY") or remote.get("api_key"),
                         args.asr_model or os.environ.get("VTYPE_MODEL") or remote.get("model"))


# ---------------------------------------------------------------- pty wrapper

def set_title(text):
    os.write(sys.stdout.fileno(), f"\x1b]0;{text}\x07".encode())


def copy_winsize(master_fd):
    size = fcntl.ioctl(sys.stdin.fileno(), termios.TIOCGWINSZ, b"\0" * 8)
    fcntl.ioctl(master_fd, termios.TIOCSWINSZ, size)


def main():
    ap = argparse.ArgumentParser(description="Push-to-talk dictation wrapper",
                                 epilog=f"Settings not given as options are read from {CONFIG}.")
    ap.add_argument("--lang", help="en-US, sv-SE, auto, ... (default en-US)")
    ap.add_argument("--key", choices=KEYS, help="record toggle key (default f9)")
    ap.add_argument("--lang-key", choices=KEYS, help="language cycle key (default f10)")
    ap.add_argument("--submit", action="store_true", default=None, help="press Enter after inserting text")
    ap.add_argument("--backend", choices=["local", "remote"], help="where the model runs (default local)")
    ap.add_argument("--url", help="remote server URL, e.g. https://asr.example.com/v1 (implies --backend remote)")
    ap.add_argument("--asr-model", help="model name sent to the remote server (default whisper-1)")
    ap.add_argument("command", nargs=argparse.REMAINDER, help="command to run (default: claude)")
    ap.add_argument("--test-mic", action="store_true", help="record 3 s, print the level and transcript")
    ap.add_argument("--configure", action="store_true", help="choose local or remote backend and write the config")
    # vtype's own options come first; everything from the first unknown argument on belongs to the
    # wrapped command, so `vtype --resume ID` (e.g. via `alias claude=vtype`) runs `claude --resume ID`
    argv, own = sys.argv[1:], []
    while argv and argv[0] != "--":
        action = ap._option_string_actions.get(argv[0].split("=", 1)[0])
        if action is None:
            break
        n = 1 if action.nargs == 0 or "=" in argv[0] else 2
        own, argv = own + argv[:n], argv[n:]
    args = ap.parse_args(own)
    cmd = argv[1:] if argv[:1] == ["--"] else argv
    if not cmd or cmd[0].startswith("-"):
        cmd = ["claude"] + cmd

    if args.configure:
        return configure()

    # herdr identifies a pane's agent by its foreground process, which is vtype, not the wrapped
    # command. HERDR_AGENT names the real agent; herdr reads it from /proc/<pid>/environ, so it
    # has to be in vtype's startup environment - hence the re-exec.
    if os.environ.get("HERDR_ENV") == "1" and "HERDR_AGENT" not in os.environ and not args.test_mic:
        env = dict(os.environ, HERDR_AGENT=os.path.basename(cmd[0]))
        os.execve(sys.executable, [sys.executable, os.path.realpath(__file__)] + sys.argv[1:], env)

    cfg = load_config()
    args.lang = args.lang or os.environ.get("VTYPE_LANG") or cfg.get("lang") or "en-US"
    args.key = args.key or cfg.get("key") or "f9"
    args.lang_key = args.lang_key or cfg.get("lang_key") or "f10"
    args.submit = args.submit if args.submit is not None else bool(cfg.get("submit", False))
    for opt in ("key", "lang_key"):
        if getattr(args, opt) not in KEYS:
            sys.exit(f"vtype: {opt} must be one of {', '.join(KEYS)}")
    backend = make_backend(args, cfg)

    if args.test_mic:
        backend.prepare()
        rec = Recorder()
        print(f"Backend: {backend.name}" + (f" ({backend.url}, model {backend.model})" if backend.name == "remote" else ""))
        print("Recording 3 s - say something...")
        rec.start()
        time.sleep(3)
        pcm = rec.stop()
        if rec.error:
            sys.exit(f"mic error: {rec.error}")
        peak = max(map(abs, array.array("h", pcm)), default=0)
        print(f"peak level: {peak / 327.68:.1f}%" + ("  <- silent: Windows isn't passing the mic to WSL" if peak < 300 else ""))
        try:
            print("transcript:", repr(backend.transcribe(pcm, args.lang)))
        except RuntimeError as e:
            sys.exit(f"error: {e}")
        return

    backend.prepare()
    rec = Recorder()
    rec_key, lang_key = KEYS[args.key], KEYS[args.lang_key]
    langs = LANGS if args.lang in LANGS else [args.lang] + LANGS
    state = {"lang": args.lang}

    # read by statusline.sh, which Claude Code runs as a child and so inherits VTYPE_STATE
    state_file = os.path.join(os.path.dirname(SOCKET), f"state-{os.getpid()}")
    os.environ["VTYPE_STATE"] = state_file

    pid, master = pty.fork()
    if pid == 0:
        os.environ.pop("HERDR_AGENT", None)  # the hint is for vtype only, not the agent's children
        try:
            os.execvp(cmd[0], cmd)
        except OSError as e:
            print(f"vtype: cannot run {cmd[0]}: {e}", file=sys.stderr)
            os._exit(127)

    write_lock = threading.Lock()

    def to_child(data):
        with write_lock:
            os.write(master, data)

    def status(msg):
        set_title(f"{msg} [{state['lang']}] {' '.join(cmd)}")
        line = {"🎙 REC": "\x1b[1;37;41m ● REC \x1b[0m", "⏳ transcribing": "\x1b[33m⏳ transcribing…\x1b[0m"}.get(
            msg, f"\x1b[2m🎙 {args.key.upper()} to talk\x1b[0m" if msg == "vtype" else f"\x1b[31m{msg}\x1b[0m")
        with open(state_file, "w") as f:
            f.write(f"{line} \x1b[2m{state['lang']}\x1b[0m\n")

    def finish(pcm, lang):
        if len(pcm) < RATE * 2 * 0.3:  # under 0.3 s: treat as an accidental tap
            status("vtype")
            return
        samples = array.array("h", pcm)
        if max(map(abs, samples)) < 300:  # ~1% of full scale: the mic delivered silence
            status("⚠ mic is silent - check Windows mic privacy settings")
            return
        status("⏳ transcribing")
        try:
            text = backend.transcribe(pcm, lang)
        except Exception as e:
            status(f"⚠ vtype: {e}")
            return
        if text:
            to_child(text.encode() + (b"\r" if args.submit else b" "))
        status("vtype")

    old_attrs = termios.tcgetattr(sys.stdin.fileno())
    tty.setraw(sys.stdin.fileno())
    signal.signal(signal.SIGWINCH, lambda *_: copy_winsize(master))

    def forward_and_exit(sig, _frame):  # e.g. terminal tab closed: pass it on, then clean up
        os.kill(pid, sig)
        raise SystemExit(128 + sig)

    signal.signal(signal.SIGHUP, forward_and_exit)
    signal.signal(signal.SIGTERM, forward_and_exit)
    copy_winsize(master)
    status("vtype")

    try:
        while True:
            try:
                ready, _, _ = select.select([sys.stdin, master], [], [])
            except InterruptedError:
                continue
            if master in ready:
                try:
                    data = os.read(master, 65536)
                except OSError:
                    break
                if not data:
                    break
                os.write(sys.stdout.fileno(), data)
            if sys.stdin in ready:
                data = os.read(sys.stdin.fileno(), 65536)
                if not data:
                    break
                while rec_key in data:
                    data = data.replace(rec_key, b"", 1)
                    if rec.recording.is_set():
                        pcm = rec.stop()
                        if rec.error:
                            status(f"⚠ mic: {rec.error}")
                        else:
                            threading.Thread(target=finish, args=(pcm, state["lang"]), daemon=True).start()
                    else:
                        rec.start()
                        status("🎙 REC")
                while lang_key in data:
                    data = data.replace(lang_key, b"", 1)
                    state["lang"] = langs[(langs.index(state["lang"]) + 1) % len(langs)]
                    status("🎙 REC" if rec.recording.is_set() else "vtype")
                if data:
                    to_child(data)
    finally:
        try:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSAFLUSH, old_attrs)
        except termios.error:  # terminal already gone
            pass
        if rec.recording.is_set():
            rec.stop()
        try:
            os.unlink(state_file)
        except FileNotFoundError:
            pass
        _, status_code = os.waitpid(pid, 0)
    sys.exit(os.waitstatus_to_exitcode(status_code))


if __name__ == "__main__":
    main()
